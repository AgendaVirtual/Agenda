{
  "name": "planner-virtual-backend",
  "version": "1.0.0",
  "description": "Backend do Planner Virtual - PLP UFAPE",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
